# Copie para .env na raiz do frontend.
# URL base da API, sem /api e sem barra final.
VITE_SERVER_URL=http://localhost:3333

# Variáveis VITE_* são públicas e incorporadas ao código do navegador.
# Nunca coloque senhas, JWT_SECRET ou credenciais do banco neste arquivo.
# Reinicie o Vite após mudanças; em produção, gere um novo build.

# Playwright: exporte no shell/CI antes de npm test.
# A configuração do Playwright NÃO carrega estas variáveis do .env.
# CHROMIUM_PATH=/usr/bin/chromium
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=
# TEST_DB_ADMIN=postgres
# PSQL_BIN=psql
# O usuário PostgreSQL de testes precisa de CREATEDB.
# A suíte define sua própria URL de API (porta 3334).
